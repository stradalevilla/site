NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapa da regiao em relevo 3D (/localizacao#a-regiao).
# Chave gratuita em maptiler.com — restrinja ao dominio do site.
# Sem ela, a secao mostra a imagem estatica e nada quebra.
NEXT_PUBLIC_MAPTILER_KEY=

# CRM da Sotheby's: o endereço do webhook do Zapier que recebe os contatos do formulário.
# Fica só em produção, na Vercel. Sem ele nada vai para o CRM: o localhost e as prévias
# gravam o contato normalmente, sem criar lead de teste na Sotheby's.
CRM_WEBHOOK_URL=

# Senha do cron diário que reenvia ao CRM o que ficou para trás. Crie na Vercel, em produção,
# com um valor aleatório: ela a envia ao cron. Sem isso, nada é reenviado.
CRON_SECRET=
